# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Hostinger SMTP credentials
# Port 465 with SMTP_SECURE=true (SSL) is recommended
# Port 587 with SMTP_SECURE=false (STARTTLS) also works
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@reyaav.in
# Wrap in double quotes if the password contains # or spaces — otherwise dotenv treats # as a comment
SMTP_PASS="ReyaaV!@#2026"

# Mail addresses
MAIL_FROM="Reya AV Website <info@reyaav.in>"
MAIL_TO=info@reyaav.in
